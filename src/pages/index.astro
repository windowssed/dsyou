---
import AnimatedButton from '@/components/base/AnimatedButton.astro'
import ExperienceTimeline from '@/components/base/ExperienceTimeline.astro'
import Link from '@/components/base/Link.astro'
import SocialIcons from '@/components/base/SocialIcons.astro'
import PageHead from '@/components/posts/base/PageHead.astro'
import BlogCard from '@/components/posts/card/BlogCard.astro'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE, SOCIAL_LINKS } from '@/config'
import Layout from '@/layouts/Layout.astro'
import {
  getFeaturedProjects,
  getRecentExperiences,
  getRecentPosts,
} from '@/lib/data-utils'

const blog = await getRecentPosts(SITE.featuredPostCount)
const projects = await getFeaturedProjects(SITE.featuredProjectCount)
const experiences = await getRecentExperiences(SITE.featuredExperienceCount)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="首页" />
  <!-- Hero Section -->
  <section class="bg-grid-pattern">
    <div class="px-6 pt-6">
      <div
        id="profile-image-container"
        class="group relative mx-auto mb-6 w-48 rotate-2 bg-white p-2 pb-10 shadow-lg transition-all duration-300 hover:scale-105 hover:rotate-3 hover:shadow-xl md:float-right md:mb-4 md:ml-8"
      >
        <img
          src="/avatar.avif"
          alt="shiyou"
          width="1220"
          height="1220"
          class="relative block h-auto w-full border border-gray-200"
        />
        <p
          class="font-pingfang-mengmeng absolute bottom-2 left-1/2 -translate-x-1/2 text-lg whitespace-nowrap text-gray-800"
        >
          你好呀 :)
        </p>
      </div>
      <div class="flex flex-col items-center space-y-1.5 md:items-start">
        <h1
          class="text-accent font-caveat text-center text-8xl leading-none font-extrabold md:text-left md:text-9xl"
        >
          shiyou
        </h1>
      </div>
      <p
        class="text-base text-muted-foreground mt-4 text-center font-serif md:text-left"
      >
        你好，我是 <strong>shiyou</strong>。这里主要分享股票投资相关的观察、行业研究、公司分析与市场思考，也会记录一些投资方法、数据整理和复盘内容。
      </p>
      <p
        class="text-muted-foreground text-base mt-4 text-center font-serif md:text-left"
      >
        市场每天都有新故事，股价偶尔也会加入“剧情反转”。因此这里既关注机会，也关注风险，尽量把复杂的投资话题讲得清楚一点、轻松一点。
      </p>
      <p
        class="text-muted-foreground text-base mt-4 text-center font-serif md:text-left"
      >
        欢迎来这里看看，或许能找到几篇有用的文章，也可能顺便发现几个值得继续研究的方向。
      </p>
      <div class="mt-8 flex flex-col items-center gap-8 md:items-start">
        <div class="flex flex-wrap items-center justify-center gap-3">
          <AnimatedButton
            href="/about"
            icon="lucide:arrow-right"
            iconPosition="right"
            variant="outline"
          >
            关于我
          </AnimatedButton>
          <AnimatedButton
            href={SOCIAL_LINKS[0]?.href ?? '/blog'}
            icon="lucide:arrow-right"
            iconPosition="right"
            variant="default"
          >
            GitHub
          </AnimatedButton>
        </div>
        <SocialIcons links={SOCIAL_LINKS} />
      </div>
    </div>
  </section>

  {
    experiences.length > 0 && (
      <section>
        <h2 class="mt-12 text-5xl font-bold">
          经历<span class="text-accent">.</span>
        </h2>
        <p class="text-muted-foreground mb-6 text-2xl">
          学习与<span
            class="text-foreground decoration-accent font-serif italic underline"
            >工作</span
          >的经历。
        </p>
        <ExperienceTimeline experiences={experiences} />
        <div class="mt-4 flex justify-center">
          <Link
            href="/experience"
            class={buttonVariants({ variant: 'ghost' }) + ' group'}
          >
            查看全部经历
            <span class="ml-1.5 transition-transform group-hover:translate-x-1"
              >&rarr;</span
            >
          </Link>
        </div>
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section class="mt-12 flex flex-col">
        <h2 class="text-5xl font-bold">
          项目<span class="text-accent">.</span>
        </h2>
        <p class="text-muted-foreground mb-4 text-2xl">
          最近<span
            class="text-foreground decoration-accent font-serif italic underline"
            >做</span
          >的东西。
        </p>
        <ul class="flex flex-col gap-y-4">
          {
            projects.map((project) => (
              <li>
                <ProjectCard entry={project} />
              </li>
            ))
          }
        </ul>
        <div class="mt-4 flex justify-center">
          <Link
            href="/projects"
            class={buttonVariants({ variant: 'ghost' }) + ' group'}
          >
            查看全部项目 <span
              class="ml-1.5 transition-transform group-hover:translate-x-1"
              >&rarr;</span
            >
          </Link>
        </div>
      </section>
    )
  }

  <!-- Latest Posts Section -->
  <section class="mt-12 flex flex-col">
    <h2 class="text-5xl font-bold">
      文章<span class="text-accent">.</span>
    </h2>
    <p class="text-muted-foreground mb-6 text-2xl">
      最近<span
        class="text-foreground decoration-accent font-serif italic underline"
        >写</span
      >的文章。
    </p>
    <ul class="flex flex-col gap-y-4">
      {
        blog.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
    <div class="mt-4 flex justify-center">
      <Link
        href="/blog"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        查看全部文章 <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
</Layout>
