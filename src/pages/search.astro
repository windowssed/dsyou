---
import Breadcrumbs from '@/components/base/Breadcrumbs.astro'
import PageHead from '@/components/posts/base/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
---

<Layout class="max-w-3xl">
  <PageHead
    slot="head"
    title="搜索"
    description="搜索博客文章"
  />
  <Breadcrumbs items={[{ label: '搜索', icon: 'lucide:search' }]} />

  <div class="flex flex-col gap-y-6">
    <div>
      <h1 class="mb-2 text-3xl font-semibold">搜索</h1>
      <p id="search-stats" class="text-muted-foreground text-sm">
        正在加载搜索索引...
      </p>
    </div>

    <div class="relative">
      <Icon
        name="lucide:search"
        class="text-muted-foreground pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2"
      />
      <input
        type="search"
        id="search-input"
        placeholder="搜索文章、项目和页面..."
        class="border-input bg-background placeholder:text-muted-foreground focus-visible:border-accent flex h-9 w-full rounded-md border px-3 py-1 pl-9 text-sm transition-colors focus-visible:outline-none"
        autofocus
      />
    </div>

    <div id="search-results" class="flex flex-col gap-y-4"></div>
    <div id="search-empty" class="hidden py-12 text-center">
      <p class="text-muted-foreground">
        没有找到结果，换个关键词试试。
      </p>
    </div>
    <div id="search-loading" class="py-12 text-center">
      <p class="text-muted-foreground">正在加载搜索索引...</p>
    </div>
    <div id="search-initial" class="hidden py-12 text-center">
      <p class="text-muted-foreground">输入关键词开始搜索...</p>
    </div>
    <div id="search-error" class="hidden py-12 text-center">
      <p class="text-muted-foreground">搜索索引加载失败，请刷新页面重试。</p>
    </div>
  </div>
</Layout>

<script is:inline>
  ;(function () {
    let isInitialized = false
    let currentInputHandler = null
    // 搜索索引从 /search-index.json 异步加载，避免把全部文章正文内联进首屏
    let allSearchData = null
    let searchIndexPromise = null

    function initSearch() {
      // Prevent multiple initializations
      if (isInitialized) {
        return
      }

      const searchInput = document.getElementById('search-input')
      const searchResults = document.getElementById('search-results')
      const searchEmpty = document.getElementById('search-empty')
      const searchInitial = document.getElementById('search-initial')
      const searchLoading = document.getElementById('search-loading')
      const searchError = document.getElementById('search-error')

      if (
        !searchInput ||
        !searchResults ||
        !searchEmpty ||
        !searchInitial ||
        !searchLoading ||
        !searchError
      ) {
        // Can happen during prefetch / partial renders: just skip initialization
        return
      }

      // Remove existing event listener if any
      if (currentInputHandler) {
        searchInput.removeEventListener('input', currentInputHandler)
      }

      function escapeHtml(text) {
        if (text == null) return ''
        const div = document.createElement('div')
        div.textContent = text.toString()
        return div.innerHTML
      }

      function highlightMatch(text, query) {
        if (text == null) return ''
        const safeText = text.toString()
        if (!query.trim()) return escapeHtml(safeText)
        const regex = new RegExp(`(${escapeRegex(query)})`, 'gi')
        const parts = safeText.split(regex)
        return parts
          .map((part, i) => {
            if (i % 2 === 1) {
              // This is a match
              return `<mark style="background-color: var(--highlight);" class="rounded px-0.5 font-medium">${escapeHtml(part)}</mark>`
            }
            return escapeHtml(part)
          })
          .join('')
      }

      function escapeRegex(str) {
        return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
      }

      function getTypeLabel(type) {
        switch (type) {
          case 'post':
            return '文章'
          case 'project':
            return '项目'
          case 'page':
            return '页面'
          default:
            return ''
        }
      }

      // 生成结果描述：优先命中 description，否则取正文命中的上下文摘录
      function buildSnippet(item, query) {
        const description = (item.description || '').toString()
        if (description.toLowerCase().includes(query)) {
          return { text: description, isBody: false }
        }

        const body = (item.body || '').toString()
        const bodyLower = body.toLowerCase()
        const idx = bodyLower.indexOf(query)
        if (idx === -1) {
          return { text: description, isBody: false }
        }

        const radius = 36
        const start = Math.max(0, idx - radius)
        const end = Math.min(body.length, idx + query.length + radius)
        const prefix = start > 0 ? '…' : ''
        const suffix = end < body.length ? '…' : ''
        return {
          text: prefix + body.slice(start, end) + suffix,
          isBody: true,
        }
      }

      function searchItems(query) {
        const normalizedQuery = (query || '').toLowerCase().trim()

        if (!normalizedQuery) {
          searchResults.innerHTML = ''
          searchEmpty.classList.add('hidden')
          searchInitial.classList.remove('hidden')
          return
        }

        // 索引未就绪时先不搜索，加载完成后由 onIndexReady 自动补搜
        if (!allSearchData) {
          return
        }

        searchInitial.classList.add('hidden')

        const matchingItems = allSearchData
          .map((item) => {
            const title = (item.title || '').toString().toLowerCase()
            const description = (item.description || '')
              .toString()
              .toLowerCase()
            const body = (item.body || '').toString().toLowerCase()
            const tags = Array.isArray(item.tags) ? item.tags : []

            const titleMatch = title.includes(normalizedQuery)
            const descriptionMatch = description.includes(normalizedQuery)
            const bodyMatch = body.includes(normalizedQuery)
            const tagsMatch = tags.some((tag) =>
              (tag || '').toString().toLowerCase().includes(normalizedQuery),
            )

            if (
              !titleMatch &&
              !descriptionMatch &&
              !bodyMatch &&
              !tagsMatch
            ) {
              return null
            }

            // 加权打分：标题 > 描述 > 标签 > 正文，命中越多排越前
            const score =
              (titleMatch ? 4 : 0) +
              (descriptionMatch ? 3 : 0) +
              (tagsMatch ? 2 : 0) +
              (bodyMatch ? 1 : 0)

            return { item, score }
          })
          .filter(Boolean)
          .sort((a, b) => b.score - a.score)
          .map((entry) => entry.item)

        if (matchingItems.length === 0) {
          searchResults.innerHTML = ''
          searchEmpty.classList.remove('hidden')
          return
        }

        searchEmpty.classList.add('hidden')

        searchResults.innerHTML = matchingItems
          .map(
            (item) => {
              const snippet = buildSnippet(item, normalizedQuery)
              return `
          <div class="hover:bg-muted/50 rounded-xl border p-4 transition-colors duration-300 ease-in-out">
            <a href="${item.slug}" class="flex flex-col gap-4 sm:flex-row sm:items-stretch">
              <div class="grow flex flex-col">
                <div class="flex items-center gap-2 mb-1">
                  <h3 class="text-lg font-medium">${highlightMatch(item.title, normalizedQuery)}</h3>
                  <span class="text-xs text-muted-foreground">${getTypeLabel(item.type)}</span>
                </div>
                <p class="text-muted-foreground mb-2 text-sm">${highlightMatch(snippet.text, normalizedQuery)}</p>
                ${snippet.isBody ? '<span class="text-muted-foreground/60 mb-2 text-xs">匹配于正文</span>' : ''}
                ${
                  item.tags.length > 0
                    ? `<div class="flex flex-wrap gap-2">
                        ${item.tags
                          .map(
                            (tag) =>
                              `<span class="inline-flex items-center rounded-md bg-muted px-2 py-1 text-xs font-medium text-foreground">
                                #${highlightMatch(tag, normalizedQuery)}
                              </span>`,
                          )
                          .join('')}
                      </div>`
                    : ''
                }
              </div>
            </a>
          </div>
        `
            }
          )
          .join('')
      }

      // 索引加载完成后的收尾：更新统计、恢复占位状态、补搜用户已输入的查询
      function onIndexReady() {
        searchLoading.classList.add('hidden')

        const statsEl = document.getElementById('search-stats')
        if (statsEl && allSearchData) {
          const postCount = allSearchData.filter(
            (item) => item.type === 'post',
          ).length
          const projectCount = allSearchData.filter(
            (item) => item.type === 'project',
          ).length
          statsEl.textContent = `可以搜索 ${postCount} 篇文章、${projectCount} 个项目和页面`
        }

        if (searchInput.value.trim()) {
          searchItems(searchInput.value)
        } else {
          searchInitial.classList.remove('hidden')
        }
      }

      async function loadSearchIndex() {
        try {
          const res = await fetch('/search-index.json')
          if (!res.ok) throw new Error(`HTTP ${res.status}`)
          allSearchData = await res.json()
          onIndexReady()
        } catch (err) {
          console.error('加载搜索索引失败：', err)
          searchLoading.classList.add('hidden')
          searchError.classList.remove('hidden')
        }
      }

      // Create new input handler
      currentInputHandler = (e) => {
        const query = e.target.value
        searchItems(query)
        // Update URL without reload
        const url = new URL(window.location.href)
        if (query) {
          url.searchParams.set('q', query)
        } else {
          url.searchParams.delete('q')
        }
        window.history.replaceState({}, '', url.toString())
      }

      // Handle input changes
      searchInput.addEventListener('input', currentInputHandler)

      // Handle URL query parameter on load
      const urlParams = new URLSearchParams(window.location.search)
      const queryParam = urlParams.get('q')
      if (queryParam) {
        searchInput.value = queryParam
        searchItems(queryParam)
      }

      // 启动索引加载（只加载一次）
      if (!searchIndexPromise) {
        searchIndexPromise = loadSearchIndex()
      }

      isInitialized = true
    }

    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearch)
    } else {
      initSearch()
    }

    // Re-initialize on Astro view transitions (if enabled)
    document.addEventListener('astro:page-load', function () {
      isInitialized = false
      initSearch()
    })
  })()
</script>
